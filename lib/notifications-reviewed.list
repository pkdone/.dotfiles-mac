# Third-party apps already reviewed on this Mac (the macOS 27 snapshot).
# macconfig-check.sh prints an info line for a bundle id that appears in the
# usernoted store, is not com.apple.* or _SYSTEM_CENTER_*, and is in neither
# this file nor lib/notifications-off.list. That is how a newly appeared app
# gets flagged. Add the id here once you've decided to leave its notifications
# as they are, or to lib/notifications-off.list if Allow Notifications must be Off.
#
# One bundle id per line. Text after # is a comment. Blank lines and lines
# beginning with # are ignored.
#
# Ids also listed in lib/notifications-off.list are included so this file is the
# full third-party snapshot. The Off list still wins: those apps must be off.

com.tinyspeck.slackmacgap # Slack (must be Off: lib/notifications-off.list)
com.spotify.client # Spotify (must be Off: lib/notifications-off.list)
com.microsoft.teams2 # Microsoft Teams (must be Off: lib/notifications-off.list)
co.anysphere.cursor.nightly # Cursor Nightly (must be Off: lib/notifications-off.list)
com.google.Chrome # Chrome (flags 41951246; bit 25 set in the snapshot)
org.hammerspoon.Hammerspoon # Hammerspoon (alert style is checked: manual step mode-hammerspoon-alerts)
# Allow Notifications left on. Reviewed, so they are not info lines, and they
# are not in lib/notifications-off.list, so on is allowed.
com.google.Chrome.framework.AlertNotificationService # Chrome alerts
us.zoom.xos # Zoom
com.mitchellh.ghostty # Ghostty
com.anthropic.claudefordesktop # Claude
com.todesktop.230313mzl4w4u92 # Cursor
com.electron.dockerdesktop # Docker Desktop
# Same apps as the new lib/notifications-off.list rows. The Off list still wins.
io.tailscale.ipn.macsys # Tailscale (must be Off: lib/notifications-off.list)
com.logi.cp-dev-mgr # Logi Options+ (must be Off: lib/notifications-off.list)
org.cogx.cog # Cog (must be Off: lib/notifications-off.list)
com.google.GeminiMacOS # Gemini (must be Off: lib/notifications-off.list)
com.anysphere.sand # Grok Bot (must be Off: lib/notifications-off.list)
com.openai.codex # ChatGPT (must be Off: lib/notifications-off.list)
com.canonical.multipassGui # Multipass (must be Off: lib/notifications-off.list)
com.yubico.yubioath # Yubico Authenticator (must be Off: lib/notifications-off.list)
com.google.Chrome.app.cinhimbnkkaeohfgghhklpknlkffjgod # YouTube Music (must be Off: lib/notifications-off.list)
com.sonos.macController2 # Sonos (must be Off: lib/notifications-off.list)
