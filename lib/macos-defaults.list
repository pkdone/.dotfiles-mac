# Managed macOS `defaults`, one per line. Loaded by macos.sh (and read by macconfig-check.sh).
# Format (pipe-delimited): domain | key | type | desired | restart | area | label | display-value | tol
#   domain:  plain defaults domain, or @host/<domain> for `defaults -currentHost` (ByHost)
#   type:    string | int | float | bool
#   tol:     optional ± tolerance for int/float (e.g. 1 => desired ±1 all pass); blank/omitted = exact
#   restart: process to killall after a change (Dock / Finder / SystemUIServer), or "logout", or empty
#   display: uses literal Markdown backticks for `macos.sh --list`; @HOME@ -> $HOME at runtime
# Blank lines and lines beginning with # are ignored.
# Dark mode. restart is empty: the default is written, and macos.sh also tells
# System Events to turn dark mode on immediately when it is not already on.
# A missing Automation permission is a warning. No logout.
NSGlobalDomain|AppleInterfaceStyle|string|Dark||Appearance|Theme|`Dark`
com.apple.dock|tilesize|float|28|Dock|Dock|Icon size|`28` (exact)
com.apple.dock|show-recents|bool|false|Dock|Dock|Show recent apps|`false` (Off)
com.apple.dock|mru-spaces|bool|false|Dock|Dock|Auto-rearrange Spaces|`false` (Off)
# Hot Corners — all Disabled (1). 14 = Quick Note (Apple default BR); hover pops a note stub, click opens Notes.
com.apple.dock|wvous-tl-corner|int|1|Dock|Dock|Hot Corner top-left|`1` (Disabled)
com.apple.dock|wvous-tl-modifier|int|0|Dock|Dock|Hot Corner top-left modifier|`0` (none)
com.apple.dock|wvous-tr-corner|int|1|Dock|Dock|Hot Corner top-right|`1` (Disabled)
com.apple.dock|wvous-tr-modifier|int|0|Dock|Dock|Hot Corner top-right modifier|`0` (none)
com.apple.dock|wvous-bl-corner|int|1|Dock|Dock|Hot Corner bottom-left|`1` (Disabled)
com.apple.dock|wvous-bl-modifier|int|0|Dock|Dock|Hot Corner bottom-left modifier|`0` (none)
com.apple.dock|wvous-br-corner|int|1|Dock|Dock|Hot Corner bottom-right|`1` (Disabled — was Quick Note)
com.apple.dock|wvous-br-modifier|int|0|Dock|Dock|Hot Corner bottom-right modifier|`0` (none)
# Minimize into the app icon, and no bounce when an app opens.
# restart=Dock, same as the com.apple.dock rows above (killall Dock only if a value changed).
com.apple.dock|minimize-to-application|bool|true|Dock|Dock|Minimize windows into application icon|`true` (On)
com.apple.dock|no-bouncing|bool|true|Dock|Dock|Animate opening applications|`true` (Off — no bounce)
com.apple.spaces|spans-displays|bool|false|logout|Dock|Displays have separate Spaces|`false` (separate Spaces On)
# Switching to an app moves to a Space that already has its windows.
NSGlobalDomain|AppleSpacesSwitchOnActivate|bool|true|logout|Dock|Switch to a Space with open windows|`true` (On)
com.apple.finder|FXPreferredViewStyle|string|icnv|Finder|Finder|Default view|`icnv` (Icon view)
com.apple.finder|ShowHardDrivesOnDesktop|bool|false|Finder|Finder|Hard drives on Desktop|`false` (Off)
com.apple.finder|NewWindowTarget|string|PfHm|Finder|Finder|New window target|`PfHm` (Home)
com.apple.finder|_FXShowPosixPathInTitle|bool|true|Finder|Finder|Full POSIX path in title|`true` (On)
NSGlobalDomain|AppleShowAllExtensions|bool|true|Finder|Finder|Show all filename extensions|`true` (On)
NSGlobalDomain|NSTableViewDefaultSizeMode|int|3||Appearance|Sidebar icon size|`3` (Large)
com.apple.finder|ShowStatusBar|bool|true|Finder|Finder|Show Status Bar|`true` (On)
# Apple's own spelling of this key drops the e in Section. 0 / false keeps the
# Tags group in the sidebar closed. Recents hidden is the sidebar Recents
# check. Shared, AirDrop, iCloud Drive, and the Locations rows are checked
# when the sidebar files name them (lib/finder-sidebar-rows.list). A row the
# files do not name stays by hand. ShowRecentTags and
# SidebarShowingiCloudDesktop are not pinned: their values were not confirmed.
com.apple.finder|SidebarTagsSctionDisclosedState|bool|false|Finder|Finder|Tags group in the sidebar|`false` (closed)
# Finder and Trash tidy. Finder restart so open windows pick the prefs up.
# DSDontWriteNetworkStores: the domain may not exist yet; defaults write creates it.
com.apple.finder|FXRemoveOldTrashItems|bool|true|Finder|Finder|Remove Trash items after 30 days|`true` (On)
com.apple.finder|FXDefaultSearchScope|string|SCcf|Finder|Finder|Search scope|`SCcf` (current folder)
com.apple.finder|_FXSortFoldersFirst|bool|true|Finder|Finder|Keep folders on top|`true` (On)
com.apple.desktopservices|DSDontWriteNetworkStores|bool|true|Finder|Finder|No .DS_Store on network volumes|`true` (On)
# Screenshots and screen recordings. @HOME@ expands to $HOME when applying and
# checking (never a hardcoded /Users/… path). install.sh and macos.sh mkdir -p the
# folder before the location is written. Existing pictures are not moved.
# `location` is the save folder for both screenshots and recordings. A separate
# recording-folder key is not part of this domain, so none is invented here.
# style and video are real screencapture keys (window capture, and video on).
# video is On as integer 1 or boolean true. macOS stores it either way; the
# check and macos.sh treat those as the same, so --fix does not leave a type
# mismatch behind. All of these restart SystemUIServer.
com.apple.screencapture|location|string|@HOME@/Pictures/Screenshots|SystemUIServer|Screenshots|Save location|`~/Pictures/Screenshots`
com.apple.screencapture|show-thumbnail|bool|true|SystemUIServer|Screenshots|Floating thumbnail|`true` (On)
com.apple.screencapture|style|string|window|SystemUIServer|Screenshots|Capture style|`window`
com.apple.screencapture|video|int|1|SystemUIServer|Screenshots|Include video capture|`1` (On)
com.apple.menuextra.clock|ShowAMPM|bool|true|SystemUIServer|Control Center|Clock — Show AM/PM|`true` (On)
com.apple.menuextra.clock|ShowDayOfWeek|bool|true|SystemUIServer|Control Center|Clock — Show day of week|`true` (On)
com.apple.menuextra.clock|ShowDate|int|1|SystemUIServer|Control Center|Clock — Show date|`1` (On)
NSGlobalDomain|com.apple.sound.beep.feedback|int|1||Sound|Volume-change feedback|`1` (On)
# Alert volume is about 0.69. ±0.02 lets a nearby slider value match.
NSGlobalDomain|com.apple.sound.beep.volume|float|0.69||Sound|Alert volume|`0.69` (about 0.69)|0.02
@host/com.apple.controlcenter|Spotlight|int|8|ControlCenter|Menu Bar|Spotlight|`8` (Don't Show)
@host/com.apple.controlcenter|FocusModes|int|8|ControlCenter|Menu Bar|Focus|`8` (Don't Show)
com.apple.ImageCapture|disableHotPlug|bool|true||Photos|Open Photos for devices|`true` (Off — do not auto-open)
@host/com.apple.controlcenter|NowPlaying|int|8|ControlCenter|Menu Bar|Now Playing|`8` (Don't Show)
# Same ByHost domain and ControlCenter restart as Spotlight / Focus / Now Playing.
# 8 = Don't Show in Menu Bar. 2 = Show in Menu Bar.
# BatteryShowPercentage is a boolean. `defaults read` prints 1 for On.
@host/com.apple.controlcenter|VoiceControl|int|8|ControlCenter|Menu Bar|Voice Control|`8` (Don't Show)
@host/com.apple.controlcenter|Bluetooth|int|2|ControlCenter|Menu Bar|Bluetooth|`2` (Show in Menu Bar)
@host/com.apple.controlcenter|BatteryShowPercentage|bool|true|ControlCenter|Menu Bar|Battery percentage|`true` (On)
com.apple.HIToolbox|AppleFnUsageType|int|0||Keyboard|Press fn/Globe key to|`0` (Do Nothing)
com.apple.assistant.support|Dictation Enabled|bool|false||Keyboard|Dictation|`false` (Off)
org.hammerspoon.Hammerspoon|MJShowDockIconKey|bool|false||Hammerspoon|Dock icon|`false` (Off — menu-bar icon only)
org.hammerspoon.Hammerspoon|HSUploadCrashData|bool|false||Hammerspoon|Upload crash data|`false` (Off)
# Trackpad. Values match this Mac today, so applying them changes nothing until one drifts.
# restart=logout: if activateSettings is missing or fails, a logout/login may be
# needed before the trackpad follows a new value. When activateSettings -u
# succeeds, macos.sh does not ask for a logout for these rows.
# Secondary click stays the bottom-right corner (TrackpadCornerSecondaryClick=2).
# Clicking the right side of the trackpad stays off (TrackpadRightClick=0).
# Force Click and haptic feedback are On (ActuateDetents=1, ForceSuppressed=0).
# Look up & data detectors is checked on manual step trackpad-lookup
# (NSGlobalDomain com.apple.trackpad.forceClick = 0). It is not written here.
# Accessibility dragging (Dragging=1, DragLock=0) stays a check there too: defaults write
# does not reliably drive the Trackpad Options… sheet
# (System Settings → Accessibility → Pointer Control).
# Mouse tracking (com.apple.mouse.scaling = 1.5, 7th notch from Slow) and scrolling
# (com.apple.scrollwheel.scaling = 0.5, 5th notch from Slow)
# stay a check on manual step mouse-settings for the same reason. Do not add those keys here.
# The gesture keys below are the same two trackpad domains as tap to click, so they are
# written the same way. Natural scrolling is on. Swipe between pages with a scroll is off.
# A fresh Mac may store these 0/1 keys as booleans. Boolean true is 1 and false
# is 0. That is the same value, not a type mismatch. When the value differs, the
# write uses the type already stored (`-bool` when the key is a boolean). The
# numbers below stay the intended values. A gesture code of 2 or 3 is not a boolean.
com.apple.AppleMultitouchTrackpad|Clicking|int|1|logout|Trackpad|Tap to click|`1` (On)
com.apple.driver.AppleBluetoothMultitouch.trackpad|Clicking|int|1|logout|Trackpad|Tap to click (Bluetooth trackpad)|`1` (On)
NSGlobalDomain|com.apple.mouse.tapBehavior|int|1|logout|Trackpad|Tap to click behavior|`1` (On)
com.apple.AppleMultitouchTrackpad|FirstClickThreshold|int|0|logout|Trackpad|Click pressure|`0` (Light)
com.apple.AppleMultitouchTrackpad|TrackpadCornerSecondaryClick|int|2|logout|Trackpad|Secondary click corner|`2` (bottom right)
com.apple.AppleMultitouchTrackpad|TrackpadRightClick|int|0|logout|Trackpad|Secondary click on the right side|`0` (Off)
com.apple.AppleMultitouchTrackpad|TrackpadThreeFingerDrag|int|0|logout|Trackpad|Three-finger drag|`0` (Off)
NSGlobalDomain|com.apple.trackpad.scaling|float|0.6875|logout|Trackpad|Tracking speed|`0.6875` (Slower)
com.apple.AppleMultitouchTrackpad|ActuateDetents|int|1|logout|Trackpad|Force Click|`1` (On)
com.apple.AppleMultitouchTrackpad|ForceSuppressed|int|0|logout|Trackpad|Haptic feedback|`0` (On)
NSGlobalDomain|com.apple.swipescrolldirection|bool|true|logout|Trackpad|Natural scrolling|`true` (On)
NSGlobalDomain|AppleEnableSwipeNavigateWithScrolls|bool|false|logout|Trackpad|Swipe between pages|`false` (Off)
com.apple.AppleMultitouchTrackpad|TrackpadThreeFingerTapGesture|int|0|logout|Trackpad|Three-finger tap|`0` (Off)
com.apple.driver.AppleBluetoothMultitouch.trackpad|TrackpadThreeFingerTapGesture|int|0|logout|Trackpad|Three-finger tap (Bluetooth trackpad)|`0` (Off)
com.apple.AppleMultitouchTrackpad|TrackpadTwoFingerFromRightEdgeSwipeGesture|int|3|logout|Trackpad|Swipe in from the right edge|`3` (Notification Centre)
com.apple.driver.AppleBluetoothMultitouch.trackpad|TrackpadTwoFingerFromRightEdgeSwipeGesture|int|3|logout|Trackpad|Swipe in from the right edge (Bluetooth trackpad)|`3` (Notification Centre)
com.apple.AppleMultitouchTrackpad|TrackpadThreeFingerHorizSwipeGesture|int|2|logout|Trackpad|Three-finger horizontal swipe|`2` (switch full-screen apps)
com.apple.driver.AppleBluetoothMultitouch.trackpad|TrackpadThreeFingerHorizSwipeGesture|int|2|logout|Trackpad|Three-finger horizontal swipe (Bluetooth trackpad)|`2` (switch full-screen apps)
com.apple.AppleMultitouchTrackpad|TrackpadThreeFingerVertSwipeGesture|int|2|logout|Trackpad|Three-finger vertical swipe|`2` (Mission Control)
com.apple.driver.AppleBluetoothMultitouch.trackpad|TrackpadThreeFingerVertSwipeGesture|int|2|logout|Trackpad|Three-finger vertical swipe (Bluetooth trackpad)|`2` (Mission Control)
com.apple.AppleMultitouchTrackpad|TrackpadFourFingerHorizSwipeGesture|int|2|logout|Trackpad|Four-finger horizontal swipe|`2` (switch full-screen apps)
com.apple.driver.AppleBluetoothMultitouch.trackpad|TrackpadFourFingerHorizSwipeGesture|int|2|logout|Trackpad|Four-finger horizontal swipe (Bluetooth trackpad)|`2` (switch full-screen apps)
com.apple.AppleMultitouchTrackpad|TrackpadFourFingerVertSwipeGesture|int|2|logout|Trackpad|Four-finger vertical swipe|`2` (Mission Control)
com.apple.driver.AppleBluetoothMultitouch.trackpad|TrackpadFourFingerVertSwipeGesture|int|2|logout|Trackpad|Four-finger vertical swipe (Bluetooth trackpad)|`2` (Mission Control)
com.apple.AppleMultitouchTrackpad|TrackpadFourFingerPinchGesture|int|2|logout|Trackpad|Four-finger pinch|`2` (Launchpad)
com.apple.driver.AppleBluetoothMultitouch.trackpad|TrackpadFourFingerPinchGesture|int|2|logout|Trackpad|Four-finger pinch (Bluetooth trackpad)|`2` (Launchpad)
com.apple.AppleMultitouchTrackpad|TrackpadFiveFingerPinchGesture|int|2|logout|Trackpad|Five-finger pinch|`2` (Show Desktop)
com.apple.driver.AppleBluetoothMultitouch.trackpad|TrackpadFiveFingerPinchGesture|int|2|logout|Trackpad|Five-finger pinch (Bluetooth trackpad)|`2` (Show Desktop)
# Native window tiling (macOS 15+). System Settings → Desktop & Dock → Windows.
# EnableTilingByEdgeDrag is unset on this Mac. Unset is the system default, On.
# Pinning true makes a later Off into drift that macconfig --fix repairs.
# EnableTiledWindowMargins reads as 0. That is boolean false (margins Off).
# restart is empty. WindowManager applies this domain live: writing
# EnableTiledWindowMargins moves windows that are already tiled, and
# EnableTilingByEdgeDrag is read on the next edge drag. An empty restart
# means macos.sh does not killall Dock (that reloads Spaces) or WindowManager.
# Only these two tiling keys. Leave HideDesktop, EnableTopTilingByEdgeDrag,
# EnableTilingOptionAccelerator, and EnableStandardClickToShowDesktop alone.
com.apple.WindowManager|EnableTilingByEdgeDrag|bool|true||Window Tiling|Drag windows to left or right edge to tile|`true` (On)
com.apple.WindowManager|EnableTiledWindowMargins|bool|false||Window Tiling|Tiled windows have margins|`false` (Off)
# Double-click a window's title bar to fill the screen (not full screen, and not
# minimize). The older AppleMiniaturizeOnDoubleClick key is not set. If it is
# present, macos.sh deletes it (@titlebar-double-click) so it does not minimize
# instead. restart is empty: the next double-click uses the new value.
NSGlobalDomain|AppleActionOnDoubleClick|string|Fill||Windows|Double-click a window's title bar|`Fill`
# Desktop widgets and Stage Manager. Same domain. System Settings → Desktop & Dock.
# StandardHideWidgets true hides widgets on the desktop (Widgets → Show Widgets →
# On Desktop off). StageManagerHideWidgets true hides them while Stage Manager is
# on (Show Widgets → In Stage Manager off). GloballyEnabled false turns Stage
# Manager off (Desktop & Stage Manager → Stage Manager). These three replace the
# desktop-widgets manual step. restart is empty, same as the tiling rows:
# WindowManager applies the domain live (Stage Manager togglers and widget
# togglers write these keys and the desktop updates with no killall), so macos.sh
# does not killall Dock (that reloads Spaces) or WindowManager.
# Do not pin EnableStandardClickToShowDesktop (Click wallpaper to reveal desktop).
com.apple.WindowManager|StandardHideWidgets|bool|true||Desktop|Show widgets on Desktop|`true` (Off — hidden)
com.apple.WindowManager|StageManagerHideWidgets|bool|true||Desktop|Show widgets in Stage Manager|`true` (Off — hidden)
com.apple.WindowManager|GloballyEnabled|bool|false||Desktop|Stage Manager|`false` (Off)
