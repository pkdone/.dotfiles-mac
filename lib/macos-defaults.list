# Managed macOS `defaults`, one per line. Loaded by macos.sh (and read by macconfig-check.sh).
# Format (pipe-delimited): domain | key | type | desired | restart | area | label | display-value | tol
#   domain:  plain defaults domain, or @host/<domain> for `defaults -currentHost` (ByHost)
#   type:    string | int | float | bool
#   tol:     optional ± tolerance for int/float (e.g. 1 => desired ±1 all pass); blank/omitted = exact
#   restart: process to killall after a change (Dock / Finder / SystemUIServer), or "logout", or empty
#   display: uses literal Markdown backticks for `macos.sh --list`; @HOME@ -> $HOME at runtime
# Blank lines and lines beginning with # are ignored.
NSGlobalDomain|AppleInterfaceStyle|string|Dark|logout|Appearance|Theme|`Dark`
com.apple.dock|tilesize|float|28|Dock|Dock|Icon size|`28` (exact)
com.apple.dock|show-recents|bool|false|Dock|Dock|Show recent apps|`false` (Off)
com.apple.dock|mru-spaces|bool|false|Dock|Dock|Auto-rearrange Spaces|`false` (Off)
# Hot Corners — all Disabled (1). 14 = Quick Note (Apple default BR); hover pops a note stub, click opens Notes.
com.apple.dock|wvous-tl-corner|int|1|Dock|Dock|Hot Corner top-left|`1` (Disabled)
com.apple.dock|wvous-tl-modifier|int|0|Dock|Dock|Hot Corner top-left modifier|`0` (none)
com.apple.dock|wvous-tr-corner|int|1|Dock|Dock|Hot Corner top-right|`1` (Disabled)
com.apple.dock|wvous-tr-modifier|int|0|Dock|Dock|Hot Corner top-right modifier|`0` (none)
com.apple.dock|wvous-bl-corner|int|1|Dock|Dock|Hot Corner bottom-left|`1` (Disabled)
com.apple.dock|wvous-bl-modifier|int|0|Dock|Dock|Hot Corner bottom-left modifier|`0` (none)
com.apple.dock|wvous-br-corner|int|1|Dock|Dock|Hot Corner bottom-right|`1` (Disabled — was Quick Note)
com.apple.dock|wvous-br-modifier|int|0|Dock|Dock|Hot Corner bottom-right modifier|`0` (none)
com.apple.spaces|spans-displays|bool|false|logout|Dock|Displays have separate Spaces|`false` (separate Spaces On)
com.apple.finder|FXPreferredViewStyle|string|icnv|Finder|Finder|Default view|`icnv` (Icon view)
com.apple.finder|ShowHardDrivesOnDesktop|bool|false|Finder|Finder|Hard drives on Desktop|`false` (Off)
com.apple.finder|NewWindowTarget|string|PfHm|Finder|Finder|New window target|`PfHm` (Home)
com.apple.finder|_FXShowPosixPathInTitle|bool|true|Finder|Finder|Full POSIX path in title|`true` (On)
NSGlobalDomain|AppleShowAllExtensions|bool|true|Finder|Finder|Show all filename extensions|`true` (On)
NSGlobalDomain|NSTableViewDefaultSizeMode|int|3||Appearance|Sidebar icon size|`3` (Large)
com.apple.finder|ShowStatusBar|bool|true|Finder|Finder|Show Status Bar|`true` (On)
# Finder and Trash tidy. Finder restart so open windows pick the prefs up.
# DSDontWriteNetworkStores: the domain may not exist yet; defaults write creates it.
com.apple.finder|FXRemoveOldTrashItems|bool|true|Finder|Finder|Remove Trash items after 30 days|`true` (On)
com.apple.finder|FXDefaultSearchScope|string|SCcf|Finder|Finder|Search scope|`SCcf` (current folder)
com.apple.finder|_FXSortFoldersFirst|bool|true|Finder|Finder|Keep folders on top|`true` (On)
com.apple.desktopservices|DSDontWriteNetworkStores|bool|true|Finder|Finder|No .DS_Store on network volumes|`true` (On)
# Screenshots. @HOME@ expands to $HOME when applying and checking (never a hardcoded
# /Users/… path). install.sh and macos.sh mkdir -p the folder before the location is
# written. Existing screenshots are not moved. show-thumbnail keeps the floating thumbnail.
# Both restart SystemUIServer.
com.apple.screencapture|location|string|@HOME@/Pictures/Screenshots|SystemUIServer|Screenshots|Save location|`~/Pictures/Screenshots`
com.apple.screencapture|show-thumbnail|bool|true|SystemUIServer|Screenshots|Floating thumbnail|`true` (On)
com.apple.menuextra.clock|ShowAMPM|bool|true|SystemUIServer|Control Center|Clock — Show AM/PM|`true` (On)
com.apple.menuextra.clock|ShowDayOfWeek|bool|true|SystemUIServer|Control Center|Clock — Show day of week|`true` (On)
com.apple.menuextra.clock|ShowDate|int|1|SystemUIServer|Control Center|Clock — Show date|`1` (On)
NSGlobalDomain|com.apple.sound.beep.feedback|int|1||Sound|Volume-change feedback|`1` (On)
@host/com.apple.controlcenter|Spotlight|int|8|ControlCenter|Menu Bar|Spotlight|`8` (Don't Show)
@host/com.apple.controlcenter|FocusModes|int|8|ControlCenter|Menu Bar|Focus|`8` (Don't Show)
com.apple.ImageCapture|disableHotPlug|bool|true||Photos|Open Photos for devices|`true` (Off — do not auto-open)
@host/com.apple.controlcenter|NowPlaying|int|8|ControlCenter|Menu Bar|Now Playing|`8` (Don't Show)
com.apple.HIToolbox|AppleFnUsageType|int|0||Keyboard|Press fn/Globe key to|`0` (Do Nothing)
com.apple.assistant.support|Dictation Enabled|bool|false||Keyboard|Dictation|`false` (Off)
org.hammerspoon.Hammerspoon|MJShowDockIconKey|bool|false||Hammerspoon|Dock icon|`false` (Off — menu-bar icon only)
org.hammerspoon.Hammerspoon|HSUploadCrashData|bool|false||Hammerspoon|Upload crash data|`false` (Off)
# Trackpad. Values match this Mac today, so applying them changes nothing until one drifts.
# restart=logout: the trackpad may need a logout/login before it follows a new value.
# Force Click and haptic feedback are On (ActuateDetents=1, ForceSuppressed=0).
# Look up & data detectors is not one of these keys; it stays in lib/manual-steps.list.
# Accessibility dragging (Dragging=1, DragLock=0) stays a check there too: defaults write
# does not reliably drive System Settings → Accessibility → Pointer Control → Trackpad Options.
com.apple.AppleMultitouchTrackpad|Clicking|int|1|logout|Trackpad|Tap to click|`1` (On)
com.apple.driver.AppleBluetoothMultitouch.trackpad|Clicking|int|1|logout|Trackpad|Tap to click (Bluetooth trackpad)|`1` (On)
NSGlobalDomain|com.apple.mouse.tapBehavior|int|1|logout|Trackpad|Tap to click behavior|`1` (On)
com.apple.AppleMultitouchTrackpad|FirstClickThreshold|int|0|logout|Trackpad|Click pressure|`0` (Light)
com.apple.AppleMultitouchTrackpad|TrackpadCornerSecondaryClick|int|2|logout|Trackpad|Secondary click corner|`2` (bottom right)
com.apple.AppleMultitouchTrackpad|TrackpadRightClick|int|0|logout|Trackpad|Secondary click on the right side|`0` (Off)
com.apple.AppleMultitouchTrackpad|TrackpadThreeFingerDrag|int|0|logout|Trackpad|Three-finger drag|`0` (Off)
NSGlobalDomain|com.apple.trackpad.scaling|float|0.6875|logout|Trackpad|Tracking speed|`0.6875` (Slower)
com.apple.AppleMultitouchTrackpad|ActuateDetents|int|1|logout|Trackpad|Force Click|`1` (On)
com.apple.AppleMultitouchTrackpad|ForceSuppressed|int|0|logout|Trackpad|Haptic feedback|`0` (On)
# Native window tiling (macOS 15+). System Settings → Desktop & Dock → Windows.
# EnableTilingByEdgeDrag is unset on this Mac. Unset is the system default, On.
# Pinning true makes a later Off into drift that macconfig --fix repairs.
# EnableTiledWindowMargins reads as 0. That is boolean false (margins Off).
# restart is empty. WindowManager applies this domain live: writing
# EnableTiledWindowMargins moves windows that are already tiled, and
# EnableTilingByEdgeDrag is read on the next edge drag. An empty restart
# means macos.sh does not killall Dock (that reloads Spaces) or WindowManager.
# Only these two keys. Leave GloballyEnabled (Stage Manager), HideDesktop,
# widget keys, EnableTopTilingByEdgeDrag, and EnableTilingOptionAccelerator alone.
com.apple.WindowManager|EnableTilingByEdgeDrag|bool|true||Window Tiling|Drag windows to left or right edge to tile|`true` (On)
com.apple.WindowManager|EnableTiledWindowMargins|bool|false||Window Tiling|Tiled windows have margins|`false` (Off)
