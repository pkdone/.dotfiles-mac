# Static symlinks created by install.sh and verified by macconfig-check.sh.
# Format (pipe-delimited): repo-relative source | target (@HOME@ -> $HOME)
# The fish functions directory (fish/functions/*.fish) is one-dir-to-many-links, so it's
# handled as a glob special-case in both scripts rather than listed here.
# Blank lines and lines beginning with # are ignored.
ghostty/config|@HOME@/.config/ghostty/config
fish/config.fish|@HOME@/.config/fish/config.fish
mise/config.toml|@HOME@/.config/mise/config.toml
gitconfig|@HOME@/.gitconfig
# Directory symlink (Karabiner cannot watch a symlinked karabiner.json file — must link the dir)
karabiner|@HOME@/.config/karabiner
# Directory symlink: Hammerspoon loads init.lua plus sibling modules from ~/.hammerspoon
hammerspoon|@HOME@/.hammerspoon
# Login LaunchAgents are not symlinks. launchd WatchPaths does not expand ~ or
# $HOME, so scripts/install-launchagent.sh renders launchagents/*.plist
# (@HOME@ -> $HOME) into ~/Library/LaunchAgents as regular files. install.sh
# and macconfig-check.sh --fix do that, then reload the agent when the
# installed bytes differ. Do not add those plists back here.
