# Static symlinks created by install.sh and verified by check.sh.
# Format (pipe-delimited): repo-relative source | target (@HOME@ -> $HOME)
# The fish functions directory (fish/functions/*.fish) is one-dir-to-many-links, so it's
# handled as a glob special-case in both scripts rather than listed here.
# Blank lines and lines beginning with # are ignored.
ghostty/config|@HOME@/.config/ghostty/config
fish/config.fish|@HOME@/.config/fish/config.fish
mise/config.toml|@HOME@/.config/mise/config.toml
gitconfig|@HOME@/.gitconfig
