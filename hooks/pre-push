#!/usr/bin/env bash
#
# pre-push hook — mirror the CI lint/test gates locally so failures are caught
# before they reach GitHub. Version-controlled under hooks/ and activated by
# `git config core.hooksPath hooks` (done by install.sh / bootstrap.sh).
#
# Runs fish -n on *.fish, then tests/run-all.sh (every tests/*.test.sh, in
# parallel, plus shellcheck of the .sh files this push changes). A missing
# tool is skipped with a notice rather than blocking. Bypass with: git push --no-verify
#
set -uo pipefail

repo="$(git rev-parse --show-toplevel)" || exit 1
cd "$repo" || exit 1
status=0

echo "pre-push: running local lint/test gates..."

# --- fish syntax check ---
if command -v fish >/dev/null 2>&1; then
  echo "  fish -n (*.fish)"
  while IFS= read -r f; do
    fish -n "$f" || status=1
  done < <(find . -type f -name '*.fish' -not -path './.git/*')
else
  echo "  fish not installed — skipping fish syntax check"
fi

# stdin is the push's ref lines. tests/run-all.sh reads them so shellcheck
# diffs .sh files against the remote commit (every .sh file if that can't
# be worked out). The test list is tests/*.test.sh, not a copy of this hook.
if [ -x ./tests/run-all.sh ]; then
  ./tests/run-all.sh --shellcheck changed || status=1
else
  echo "pre-push: tests/run-all.sh missing or not executable" >&2
  status=1
fi

if [ "$status" -ne 0 ]; then
  echo "pre-push: checks FAILED — push aborted. Override with: git push --no-verify" >&2
else
  echo "pre-push: all checks passed."
fi
exit "$status"
