.DS_Store
fish_variables

# macOS defaults backups taken by macos.sh (machine-local)
backups/

# defaults discovery snapshots taken by defaults-diff.sh (machine-local)
discovery/

# agent scratch logs
.agent-logs/

# Raycast exports (.rayconfig): encrypted, but they hold clipboard history, AI chats and
# extension settings / tokens — never commit them (see README "App settings as code")
*.rayconfig

# Python helper bytecode
__pycache__/
*.py[cod]
